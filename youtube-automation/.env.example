# === AI Content Generation ===
# OpenAI API key for script generation and TTS
OPENAI_API_KEY=sk-your-openai-api-key

# Model for script generation (gpt-4o is recommended for quality, gpt-4o-mini for cost)
OPENAI_MODEL=gpt-4o-mini

# TTS voice (alloy, echo, fable, onyx, nova, shimmer)
OPENAI_TTS_VOICE=onyx
OPENAI_TTS_MODEL=tts-1

# === YouTube API ===
# Google Cloud OAuth2 credentials (from Google Cloud Console)
YOUTUBE_CLIENT_ID=your-client-id
YOUTUBE_CLIENT_SECRET=your-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback

# === Video Settings ===
# Resolution (1920x1080 recommended for YouTube)
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30

# Slide duration in seconds (how long each slide shows)
SLIDE_DURATION=8

# Background color for slides (hex)
SLIDE_BG_COLOR=#1a1a2e

# Text color for slides (hex)
SLIDE_TEXT_COLOR=#ffffff

# Accent color for slides (hex)
SLIDE_ACCENT_COLOR=#e94560

# === Output ===
OUTPUT_DIR=./output

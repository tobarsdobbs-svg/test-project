# ── REQUIRED ────────────────────────────────────────────────────────────────
# Get yours at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── OPTIONAL (adds Reddit data; tool works without these via Hacker News) ───
# Get yours at https://www.reddit.com/prefs/apps → "create another app"
# Choose type: "script"  |  redirect uri: http://localhost:3000
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# ── SERVER ───────────────────────────────────────────────────────────────────
PORT=3000
